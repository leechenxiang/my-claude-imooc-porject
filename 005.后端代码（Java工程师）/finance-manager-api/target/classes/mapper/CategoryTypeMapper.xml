<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.finance.manager.mapper.CategoryTypeMapper">

    <resultMap id="BaseResultMap" type="com.finance.manager.entity.CategoryType">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM category_types ORDER BY id
    </select>

    <select id="selectByName" resultMap="BaseResultMap">
        SELECT * FROM category_types WHERE name = #{name}
    </select>

</mapper>