<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.finance.manager.mapper.LedgerMapper">

    <resultMap id="BaseResultMap" type="com.finance.manager.entity.Ledger">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="is_default" property="isDefault"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectByUserIdAndDefault" resultMap="BaseResultMap">
        SELECT * FROM ledgers WHERE user_id = #{userId} AND is_default = 1
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM ledgers WHERE user_id = #{userId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ledgers (user_id, name, description, is_default)
        VALUES (#{userId}, #{name}, #{description}, #{isDefault})
    </insert>

</mapper>